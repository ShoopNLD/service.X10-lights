<addon id="service.X10-lights"
       name="X10 Commander Lights"
       version="0.0.2"
       provider-name="Majestic Soft">
  <requires>
    <import addon="xbmc.python" version="1.0"/>
  </requires>
  <extension point="xbmc.service"
            library="default.py" start="login|startup">
        <provides>service</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>X10 Commander Lights</summary>
    <summary lang="nl">X10 Commander Lampen</summary>
    <description>Controls lights during watching of a video, via a domotica server running the X10 Commander software from Melloware.
    </description>
    <description lang="nl">Bediend lampen tijdens het bekijken van een video, via een domotica server waar de X10 Commander software van Melloware op draait.
    </description>
    <platform>all</platform>
  </extension>
</addon>